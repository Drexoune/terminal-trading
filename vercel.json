{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd web && npm ci",
  "buildCommand": "cd web && npm run build && npm run check:bundle",
  "outputDirectory": "web/dist",
  "framework": null,
  "regions": ["cdg1"],
  "rewrites": [
    { "source": "/api/bourse/:path", "destination": "/api/bourse?path=:path" },
    { "source": "/api/p1/:path", "destination": "/api/p1?path=:path" },
    { "source": "/api/rates/:path", "destination": "/api/rates?path=:path" },
    { "source": "/api/macro/:path", "destination": "/api/macro?path=:path" },
    { "source": "/api/sentiment/:path", "destination": "/api/sentiment?path=:path" },
    { "source": "/api/alerts/:path*", "destination": "/api/alerts?path=:path*" },
    { "source": "/((?!api/|api$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
